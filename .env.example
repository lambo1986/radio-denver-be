# Heroku supplies DATABASE_URL after Postgres is attached.
DATABASE_URL=
SECRET_KEY_BASE=
JWT_SECRET_KEY=

# Exact frontend origins, comma-separated. Include Vercel preview origins only
# when they need authenticated API access.
FRONTEND_ORIGINS=https://shows.alpinegrooveguide.com
FRONTEND_URL=https://shows.alpinegrooveguide.com
BACKEND_HOST=api.alpinegrooveguide.com
SESSION_COOKIE_KEY=_melody_mixer_session

# S3 audio storage.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# Transactional email for invitations and password resets.
MAIL_FROM=Human Frequency <poole.reid@gmail.com>
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_DOMAIN=alpinegrooveguide.com
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain

# Runtime sizing and logging.
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=1
RAILS_LOG_LEVEL=info

# AzuraCast bridge. These may remain blank during the manual-export phase.
STREAM_STATION_NAME=Human Frequency
AZURACAST_BASE_URL=
AZURACAST_STATION_ID=
AZURACAST_STATION_SHORTCODE=human_frequency
AZURACAST_STREAM_URL=
AZURACAST_API_KEY=
AZURACAST_PLAYLIST_NAME=Human Frequency Shows
