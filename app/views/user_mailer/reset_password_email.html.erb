<div style="max-width: 560px; margin: 0 auto; padding: 36px; background: #15120f; color: #f5eedc; font-family: Arial, sans-serif;">
  <p style="color: #ff5a36; text-transform: uppercase; letter-spacing: 3px; font-size: 12px; font-weight: bold;">Human-made radio</p>
  <h1 style="font-family: Georgia, serif; font-size: 34px; font-weight: normal; margin-bottom: 8px;">Human Frequency</h1>
  <p style="color: #8ba1f2; text-transform: uppercase; letter-spacing: 2px; font-size: 11px;">Presented by Alpine Groove Guide</p>
  <p style="line-height: 1.6; color: #c9c0b0;">Hi <%= @user.first_name %>, use the button below to choose a new studio password. This link expires in four hours.</p>
  <p style="margin: 28px 0;">
    <a href="<%= @url %>" style="display: inline-block; padding: 14px 22px; background: #ff5a36; color: #15120f; text-decoration: none; font-weight: bold; border-radius: 999px;">Choose a new password</a>
  </p>
  <p style="font-size: 13px; line-height: 1.5; color: #8d8579;">If you did not request this, you can ignore this email.</p>
</div>
