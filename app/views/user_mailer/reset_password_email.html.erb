<div style="max-width: 560px; margin: 0 auto; padding: 32px; background: #18181b; color: #fafafa; font-family: Arial, sans-serif;">
  <p style="color: #fcd34d; text-transform: uppercase; letter-spacing: 2px; font-size: 12px;">Melody Mixer Network</p>
  <h1 style="font-size: 28px;">Reset your station password</h1>
  <p style="line-height: 1.6; color: #d4d4d8;">Hi <%= @user.first_name %>, use the button below to choose a new password. This link expires in four hours.</p>
  <p style="margin: 28px 0;">
    <a href="<%= @url %>" style="display: inline-block; padding: 14px 20px; background: #fcd34d; color: #18181b; text-decoration: none; font-weight: bold; border-radius: 6px;">Choose a new password</a>
  </p>
  <p style="font-size: 13px; line-height: 1.5; color: #a1a1aa;">If you did not request this, you can ignore this email.</p>
</div>
